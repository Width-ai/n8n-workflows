    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Builds the NetSuite sales order from the deal and its line items.\n// Each line item uses its netsuite_item_id property, or the genericItemId from Settings.\nconst settings = $('Settings').first().json;\nconst deal = $('Read Deal').item.json;\nconst customerId = $('Read Customer ID').item.json.customerId;\nconst genericItemId = String(settings.genericItemId ?? '').trim();\nconst lineItems = $input.item.json.results ?? []; // empty when the deal has no line items\n\nconst items = lineItems.map((lineItem) => {\n  const p = lineItem.properties ?? {};\n  const itemId = String(p.netsuite_item_id ?? '').trim() || genericItemId;\n  if (!itemId) {\n    throw new Error(`Line item \"${p.name}\" on HubSpot deal ${deal.dealId} has no netsuite_item_id, and no genericItemId is set in Settings. ${deal.dealUrl}`);\n  }\n  const quantity = Number(p.quantity) || 1;\n  const rate = p.price !== undefined && p.price !== null && p.price !== ''\n    ? Number(p.price)\n    : (Number(p.amount) || 0) / quantity;\n  return { item: { id: itemId }, quantity, rate, description: p.name ?? '' };\n});\n\n// No products on the deal: bill the deal amount against the generic item\nif (!items.length) {\n  if (!genericItemId) {\n    throw new Error(`HubSpot deal ${deal.dealId} has no line items, and no genericItemId is set in Settings. ${deal.dealUrl}`);\n  }\n  items.push({ item: { id: genericItemId }, quantity: 1, rate: deal.amount, description: deal.dealName });\n}\n\nconst salesOrder = {\n  entity: { id: customerId },\n  tranDate: deal.closeDate,\n  memo: deal.dealName,\n  custbody_hubspot_deal_id: deal.dealId,\n  item: { items },\n};\nconst currencyId = (settings.currencyMap ?? {})[deal.currency];\nif (currencyId) salesOrder.currency = { id: String(currencyId) };\n\nreturn {\n  json: {\n    salesOrder,\n    orderQuery: `SELECT id FROM transaction WHERE type = 'SalesOrd' AND custbody_hubspot_deal_id = '${deal.dealId.replace(/'/g, \"''\")}'`,\n  },\n};\n"
      },
