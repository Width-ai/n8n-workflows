    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Gets the contact's email (the match key) and prepares the NetSuite customer record\nconst settings = $('Settings').first().json;\nconst deal = $('Read Deal').item.json;\nconst contact = $input.item.json;\nconst p = contact.properties ?? {};\n\nconst email = String(p.email ?? '').trim().toLowerCase();\nif (!email) {\n  throw new Error(`The contact on HubSpot deal ${deal.dealId} (\"${deal.dealName}\") has no email address, so it can't be matched to a NetSuite customer. ${deal.dealUrl}`);\n}\n\n// Companies become company customers; contacts without a company become individuals\nconst customerBody = p.company\n  ? { isPerson: false, companyName: p.company }\n  : { isPerson: true, firstName: p.firstname || email.split('@')[0], lastName: p.lastname || '-' };\ncustomerBody.email = email;\nif (p.phone) customerBody.phone = p.phone;\nif (String(settings.subsidiaryId ?? '').trim()) customerBody.subsidiary = { id: String(settings.subsidiaryId).trim() };\n\nreturn {\n  json: {\n    contactId: String(contact.id),\n    email,\n    customerQuery: `SELECT id, entityid, email FROM customer WHERE LOWER(email) = '${email.replace(/'/g, \"''\")}'`,\n    customerBody,\n  },\n};\n"
      },
