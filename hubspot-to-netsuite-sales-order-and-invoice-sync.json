          "name": "NetSuite OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Turns NetSuite invoices into the HubSpot \"Invoice Status\" value, one update per deal.\n// If a deal has several changed invoices, the most recently modified one wins.\nconst rows = $input.first().json.items ?? [];\nconst deals = new Map();\n\nfor (const row of rows) {\n  const dealId = String(row.custbody_hubspot_deal_id ?? '').trim();\n  if (!dealId) continue;\n  const total = Number(row.foreigntotal) || 0;\n  const unpaid = row.foreignamountunpaid === null || row.foreignamountunpaid === undefined || row.foreignamountunpaid === ''\n    ? null\n    : Number(row.foreignamountunpaid);\n\n  let invoiceStatus = 'Invoiced';\n  if (unpaid === 0) invoiceStatus = 'Paid in Full';\n  else if (unpaid !== null && unpaid < total) invoiceStatus = 'Partially Paid';\n\n  deals.set(dealId, { dealId, invoiceStatus, invoiceNumber: row.tranid ?? '', amountUnpaid: unpaid });\n}\n\nreturn [...deals.values()].map((json) => ({ json }));\n"
      },
