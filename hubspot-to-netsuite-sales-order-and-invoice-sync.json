    {
      "parameters": {
        "jsCode": "// HubSpot sends webhook events in batches (a JSON array of up to 100 events).\n// Keep the latest dealstage change for each deal.\nconst body = $('HubSpot Deal Webhook').first().json.body;\nconst events = (Array.isArray(body) ? body : [body])\n  .filter((event) => event && typeof event === 'object')\n  .sort((a, b) => (a.occurredAt ?? 0) - (b.occurredAt ?? 0));\n\nconst deals = new Map();\nfor (const event of events) {\n  if (event.subscriptionType && event.subscriptionType !== 'deal.propertyChange') continue;\n  if (event.propertyName && event.propertyName !== 'dealstage') continue;\n  const dealId = String(event.objectId ?? '');\n  if (!dealId) continue;\n  deals.set(dealId, { dealId, stage: String(event.propertyValue ?? ''), portalId: String(event.portalId ?? '') });\n}\n\nreturn [...deals.values()].map((json) => ({ json }));\n"
      },
