    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Takes the customer ID from the SuiteQL match, or from the Location header NetSuite returns after a create\nconst deal = $('Read Deal').item.json;\nconst res = $input.item.json;\n\nconst id = res.items?.[0]?.id ?? String(res.headers?.location ?? '').match(/\\/customer\\/(\\d+)/)?.[1];\nif (!id) {\n  throw new Error(`Couldn't read the NetSuite customer ID for HubSpot deal ${deal.dealId} (\"${deal.dealName}\"). ${deal.dealUrl}`);\n}\n\nreturn { json: { customerId: String(id), createdCustomer: !res.items } };\n"
      },
