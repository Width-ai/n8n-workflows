    {
      "parameters": {
        "jsCode": "// Finds invoices changed in the last few minutes that are linked to a HubSpot deal.\n// The cutoff is in NetSuite's time zone, and overlaps the schedule so nothing is missed.\nconst settings = $('Settings').first().json;\nconst since = $now\n  .setZone(settings.netsuiteTimeZone || 'America/Los_Angeles')\n  .minus((Number(settings.invoiceLookbackMinutes) || 60) * 60 * 1000)\n  .toFormat('yyyy-MM-dd HH:mm:ss');\n\nconst invoiceQuery = [\n  'SELECT t.id, t.tranid, BUILTIN.DF(t.status) AS status_name, t.foreigntotal, t.foreignamountunpaid, t.custbody_hubspot_deal_id',\n  'FROM transaction t',\n  \"WHERE t.type = 'CustInvc'\",\n  '  AND t.custbody_hubspot_deal_id IS NOT NULL',\n  `  AND t.lastmodifieddate >= TO_DATE('${since}', 'YYYY-MM-DD HH24:MI:SS')`,\n  'ORDER BY t.lastmodifieddate',\n].join('\\n');\n\nreturn [{ json: { invoiceQuery, since } }];\n"
      },
      "id": "2628e7ff-ddca-46d3-bca8-8374d36d639a",
      "name": "Build Invoice Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ String($('Settings').first().json.netsuiteAccountId).toLowerCase().replace(/_/g, '-') }}.suitetalk.api.netsuite.com/services/rest/query/v1/suiteql?limit=1000",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "transient"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"q\": {{ JSON.stringify($json.invoiceQuery) }}\n}",
        "options": {}
      },
      "id": "12e044d7-d17d-4c77-a9e9-5580750237de",
      "name": "Find Updated Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        500
      ],
      "credentials": {
        "oAuth2Api": {
