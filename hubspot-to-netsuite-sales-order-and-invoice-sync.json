    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pulls what the sales order needs from the HubSpot deal\nconst event = $('Deal Closed Won?').item.json;\nconst deal = $input.item.json;\nconst p = deal.properties ?? {};\nconst associations = deal.associations ?? {};\nconst ids = (key) => (associations[key]?.results ?? []).map((r) => String(r.id));\n\nconst dealId = String(deal.id ?? event.dealId);\nconst lineItemIds = [...new Set([...ids('line items'), ...ids('line_items')])];\n\nreturn {\n  json: {\n    dealId,\n    dealName: p.dealname ?? '',\n    amount: Number(p.amount) || 0,\n    closeDate: String(p.closedate ?? '').slice(0, 10) || $now.toFormat('yyyy-MM-dd'),\n    currency: String(p.deal_currency_code ?? '').toUpperCase(),\n    contactId: ids('contacts')[0] ?? '',\n    lineItemIds,\n    lineItemsRequest: {\n      properties: ['name', 'quantity', 'price', 'amount', 'hs_sku', 'netsuite_item_id'],\n      inputs: lineItemIds.map((id) => ({ id })),\n    },\n    dealUrl: event.portalId\n      ? `https://app.hubspot.com/contacts/${event.portalId}/record/0-3/${dealId}`\n      : `HubSpot deal ${dealId}`,\n  },\n};\n"
      },
