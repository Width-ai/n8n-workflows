    {
      "parameters": {
        "jsCode": "// ---- Settings ---------------------------------------------------------------\n// Column in the participant sheet that holds each ticket code\nconst TICKET_COLUMN = 'TIKET';\n\n// Columns that may hold the attendee's name (the first one found is shown to staff)\nconst NAME_COLUMNS = ['NAME', 'NAMA', 'Name', 'Full Name'];\n\n// Ticket rules. Each rule is skipped when its column isn't in the participant sheet.\n// Status: reject tickets with one of these statuses (not case-sensitive)\nconst STATUS_COLUMN = 'STATUS';\nconst BLOCKED_STATUSES = ['cancelled', 'canceled', 'refunded', 'void'];\n\n// Valid dates: the day(s) a ticket can be used, e.g. 2026-09-14 or 2026-09-14, 2026-09-15\nconst VALID_DATES_COLUMN = 'VALID_DATES';\n\n// Area access: the ticket types each checkpoint admits. Checkpoints not listed admit every ticket.\nconst TICKET_TYPE_COLUMN = 'TICKET_TYPE';\nconst CHECKPOINT_ACCESS = {\n  'VIP Area': ['VIP'],\n};\n// -----------------------------------------------------------------------------\n\nconst scan = $('Clean Scan').first().json;\nconst text = (value) => String(value ?? '').trim();\nconst lower = (value) => text(value).toLowerCase();\n\n// Google Sheets returns date cells as serial numbers (days since 1899-12-30)\nconst toIsoDate = (value) => typeof value === 'number'\n  ? new Date(Date.UTC(1899, 11, 30) + Math.floor(value) * 86400000).toISOString().slice(0, 10)\n  : text(value).slice(0, 10);\n\nconst participant = scan.ticket_code\n  ? $('Read Participant Database').all()\n    .map((item) => item.json)\n    .find((row) => text(row[TICKET_COLUMN]) === scan.ticket_code)\n  : undefined;\n\nfunction findRuleViolation(row) {\n  if (STATUS_COLUMN in row && BLOCKED_STATUSES.includes(lower(row[STATUS_COLUMN]))) {\n    return `Ticket is ${lower(row[STATUS_COLUMN])}`;\n  }\n\n  if (VALID_DATES_COLUMN in row && text(row[VALID_DATES_COLUMN])) {\n    const raw = row[VALID_DATES_COLUMN];\n    const dates = typeof raw === 'number' ? [toIsoDate(raw)] : String(raw).split(',').map(toIsoDate);\n    if (!dates.includes(scan.scan_date)) {\n      return `Ticket is only valid on ${dates.join(', ')}`;\n    }\n  }\n\n  const allowedTypes = CHECKPOINT_ACCESS[scan.checkpoint];\n  if (allowedTypes && TICKET_TYPE_COLUMN in row) {\n    const ticketType = text(row[TICKET_TYPE_COLUMN]);\n    if (!allowedTypes.map(lower).includes(ticketType.toLowerCase())) {\n      return `${ticketType || 'This'} ticket isn't allowed in ${scan.checkpoint}`;\n    }\n  }\n\n  return '';\n}\n\n// A ticket counts as used once it has a VALID scan at this checkpoint on the same day\nconst firstScan = participant && $('Read Scan Results').all()\n  .map((item) => item.json)\n  .find((row) => text(row.ticket_code) === scan.ticket_code\n    && row.scan_status === 'VALID'\n    && text(row.checkpoint) === scan.checkpoint\n    && text(row.scan_date) === scan.scan_date);\n\nlet scanStatus = 'VALID';\nlet reason = '';\nif (!participant) {\n  scanStatus = 'INVALID';\n  reason = scan.ticket_code ? 'Ticket code not found' : 'No code was scanned';\n} else if ((reason = findRuleViolation(participant))) {\n  scanStatus = 'REJECTED';\n} else if (firstScan) {\n  scanStatus = 'ALREADY_USED';\n  reason = `First scanned at ${firstScan.scanned_at}`;\n}\n\nconst record = {\n  scanned_at: scan.scanned_at,\n  scan_date: scan.scan_date,\n  checkpoint: scan.checkpoint,\n  ticket_code: scan.ticket_code,\n  scan_status: scanStatus,\n  reason,\n  attendee_name: participant ? text(NAME_COLUMNS.map((column) => participant[column]).find((name) => text(name))) : '',\n};\n\n// Add the participant's details without overwriting the scan fields\nconst { row_number, ...details } = participant ?? {};\nfor (const [key, value] of Object.entries(details)) {\n  if (!(key in record)) record[key] = value;\n}\n\nreturn [{ json: record }];"
      },
