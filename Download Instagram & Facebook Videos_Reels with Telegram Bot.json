    {
      "parameters": {
        "jsCode": "// Read the post's link-preview tags: the title and description Instagram and Facebook\n// provide when a link is shared. Fields stay empty when a post doesn't expose them.\nconst html = String($input.first().json.data ?? '');\nconst platform = $('Extract Link').first().json.platform;\n\nconst decode = (value) => value\n  .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(parseInt(hex, 16)))\n  .replace(/&#(\\d+);/g, (_, code) => String.fromCodePoint(Number(code)))\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;|&apos;/g, \"'\")\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&amp;/g, '&');\n\nconst meta = (property) => {\n  const tag = html.match(new RegExp(`<meta[^>]+(?:property|name)=\"${property}\"[^>]*>`, 'i'))?.[0] ?? '';\n  return decode(tag.match(/content=\"([^\"]*)\"/i)?.[1] ?? '').trim();\n};\n\n// Generic page titles mean the post details weren't available (e.g. a login page)\nconst GENERIC = /^(instagram|facebook|log in|log into facebook|facebook - log in or sign up)$/i;\nconst title = GENERIC.test(meta('og:title')) ? '' : meta('og:title');\nconst description = GENERIC.test(meta('og:description')) ? '' : meta('og:description');\n\nlet creator = '';\nlet caption = '';\n\nif (platform === 'instagram') {\n  // Typical formats:\n  //   og:description  12K likes, 345 comments - handle on September 1, 2026: \"Caption #tag\".\n  //   og:title        Name (@handle) • Instagram reel   or   handle on Instagram: \"Caption\"\n  const quoted = /:\\s*\"([\\s\\S]*)\"\\s*\\.?\\s*$/;\n  caption = description.match(quoted)?.[1] ?? title.match(quoted)?.[1] ?? '';\n  creator = description.match(/ - ([\\w.]+) on [A-Z][a-z]+ \\d{1,2}, \\d{4}/)?.[1]\n    ?? title.match(/\\(@([\\w.]+)\\)/)?.[1]\n    ?? title.match(/^([\\w.]+) on Instagram/)?.[1]\n    ?? '';\n} else {\n  caption = description || title;\n}\n\nconst MAX_CAPTION = 700; // Telegram captions are limited to 1,024 characters\nconst hashtags = [...new Set(caption.match(/#[\\p{L}\\p{N}_]+/gu) ?? [])];\nconst shortCaption = caption.length > MAX_CAPTION ? `${caption.slice(0, MAX_CAPTION).trimEnd()}…` : caption;\n\nreturn [{\n  json: {\n    creator: creator ? `@${creator}` : '',\n    caption,\n    hashtags: hashtags.join(' '),\n    // Shown with the video in Telegram\n    summary: [creator && `👤 @${creator}`, shortCaption].filter(Boolean).join('\\n\\n') || \"Here's your video 🎬\",\n  },\n}];"
      },
