      "parameters": {
        "jsCode": "// Find the first Instagram or Facebook link in the message text or media caption\nconst message = $input.first().json.message ?? {};\nconst text = message.text ?? message.caption ?? '';\n\nconst patterns = {\n  instagram: /https?:\\/\\/(?:[\\w-]+\\.)?(?:instagram\\.com|instagr\\.am)\\/[^\\s<>\"]+/i,\n  facebook: /https?:\\/\\/(?:[\\w-]+\\.)?(?:facebook\\.com|fb\\.watch|fb\\.com)\\/[^\\s<>\"]+/i,\n};\n\nconst first = Object.entries(patterns)\n  .map(([platform, pattern]) => ({ platform, match: text.match(pattern) }))\n  .filter(({ match }) => match)\n  .sort((a, b) => a.match.index - b.match.index)[0];\n\nconst url = first\n  ? first.match[0]\n    .replace(/[).,!?]+$/, '') // punctuation that often follows a pasted link\n    .replace(/^(https?:\\/\\/)(?:[\\w-]+\\.)?fb\\.com\\//i, '$1www.facebook.com/') // the Facebook downloader only accepts facebook.com and fb.watch\n  : '';\n\nreturn [{\n  json: {\n    chatId: message.chat?.id,\n    messageId: message.message_id,\n    platform: first?.platform ?? 'none',\n    url,\n    requestedBy: message.from?.username\n      ? `@${message.from.username}`\n      : [message.from?.first_name, message.from?.last_name].filter(Boolean).join(' '),\n  },\n}];"
      },
