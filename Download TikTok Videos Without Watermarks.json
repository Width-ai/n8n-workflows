      "id": "6d5173d1-8e0a-410c-964d-486473fed308",
      "name": "Download Watermark-Free Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1260,
        -40
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Names the downloaded file tiktok_<creator>_<video ID>.mp4 and carries the post details forward\nconst { cookies, imageUrls, ...details } = $('Find Watermark-Free Video').item.json;\nconst file = $input.item.binary?.data;\n\nif (!file) {\n  return {\n    json: {\n      ...details,\n      mediaType: 'error',\n      error: \"Found the video but couldn't download it from TikTok's servers. Try again in a minute.\",\n    },\n  };\n}\n\nfile.fileName = details.fileName;\nfile.fileExtension = 'mp4';\nfile.mimeType = 'video/mp4';\n\n// The finished file is kept in its own field, tiktokFile, so later steps can't pick up an earlier download by mistake\nreturn { json: details, binary: { tiktokFile: file } };\n"
      },
      "id": "9488573f-b021-4053-8d68-510c959ca3ee",
      "name": "Name Video File",
