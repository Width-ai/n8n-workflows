      "id": "90da0677-2acd-4c38-84cc-5b9ae825d894",
      "name": "Load TikTok Video Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        540,
        -40
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Finds the watermark-free video (or slideshow photos) in the TikTok page data.\n// TikTok's web player streams the clean file. The watermark is only added to the\n// separate \"download\" file (downloadAddr), which this workflow never uses.\nconst input = $('Read TikTok Link').item.json;\nconst page = $input.item.json;\n\nconst fail = (error) => ({ json: { ...input, mediaType: 'error', error } });\n\nif (!input.tiktokUrl) {\n  return fail(\"That doesn't look like a TikTok link. Paste a link like https://www.tiktok.com/@user/video/123 or https://vm.tiktok.com/abc123/\");\n}\n\nconst html = typeof page.data === 'string' ? page.data : '';\nif (!html) {\n  const reason = typeof page.error === 'string' ? page.error : page.error?.message;\n  return fail(`Couldn't load the TikTok page${reason ? ` (${reason})` : ''}. Check the link and try again.`);\n}\n\nconst script = html.match(/<script[^>]*id=\"__UNIVERSAL_DATA_FOR_REHYDRATION__\"[^>]*>([\\s\\S]*?)<\\/script>/);\nif (!script) {\n  return fail('TikTok sent back a page without the video data, usually a bot check. Wait a minute and try again.');\n}\n\nlet detail;\ntry {\n  detail = JSON.parse(script[1])?.__DEFAULT_SCOPE__?.['webapp.video-detail'];\n} catch (e) {\n  return fail(\"Couldn't read the video data on the TikTok page.\");\n}\n\nconst post = detail?.itemInfo?.itemStruct;\nif (!post?.id) {\n  const reason = detail?.statusMsg || (detail?.statusCode ? `status ${detail.statusCode}` : 'no post data');\n  return fail(`TikTok didn't return this post (${reason}). It may be private, deleted, or not available in your region.`);\n}\n\n// TikTok only lets the file be downloaded with the cookies it set on the page, so keep them (name=value pairs only)\nconst setCookie = page.headers?.['set-cookie'] ?? [];\nconst cookies = (Array.isArray(setCookie) ? setCookie : [setCookie])\n  .map((cookie) => String(cookie).split(';')[0].trim())\n  .filter(Boolean)\n  .join('; ');\n\n// Take the ID and creator from the page data, so app share links (vm.tiktok.com/...) work too\nconst videoId = String(post.id);\nconst handle = post.author?.uniqueId ?? '';\nconst fileBaseName = `tiktok_${handle.replace(/[^\\w.-]+/g, '') || 'video'}_${videoId}`;\n\nconst details = {\n  ...input,\n  videoId,\n  creator: handle ? `@${handle}` : '',\n  caption: post.desc ?? '',\n  postUrl: handle ? `https://www.tiktok.com/@${handle}/video/${videoId}` : input.tiktokUrl,\n  cookies,\n  fileBaseName,\n};\n\n// Photo slideshows have no video file; download their photos instead\nconst imageUrls = (post.imagePost?.images ?? [])\n  .map((image) => image?.imageURL?.urlList?.[0])\n  .filter(Boolean);\n\nif (imageUrls.length) {\n  return {\n    json: {\n      ...details,\n      mediaType: 'slideshow',\n      imageUrls,\n      quality: `${imageUrls.length} photos`,\n      fileName: `${fileBaseName}.zip`,\n    },\n  };\n}\n\n// Pick the highest-quality watermark-free stream. H.264 plays everywhere,\n// while TikTok's H.265 streams don't open in many players, so prefer H.264.\nconst video = post.video ?? {};\nconst streams = (video.bitrateInfo ?? [])\n  .map((stream) => ({\n    url: stream?.PlayAddr?.UrlList?.[0] ?? '',\n    codec: String(stream?.CodecType ?? '').toLowerCase(),\n    bitrate: Number(stream?.Bitrate) || 0,\n    width: Number(stream?.PlayAddr?.Width) || 0,\n    height: Number(stream?.PlayAddr?.Height) || 0,\n  }))\n  .filter((stream) => stream.url);\n\nconst h264 = streams.filter((stream) => stream.codec.includes('h264'));\nconst best = (h264.length ? h264 : streams)\n  .sort((a, b) => b.width * b.height - a.width * a.height || b.bitrate - a.bitrate)[0];\n\nconst videoUrl = best?.url || video.playAddr || '';\nif (!videoUrl) {\n  return fail('This post has no video file TikTok will share. It may be a live replay or a restricted video.');\n}\n\nconst shortSide = best ? Math.min(best.width, best.height) : 0;\n\nreturn {\n  json: {\n    ...details,\n    mediaType: 'video',\n    videoUrl,\n    quality: shortSide ? `${shortSide}p` : 'standard',\n    fileName: `${fileBaseName}.mp4`,\n  },\n};\n"
      },
