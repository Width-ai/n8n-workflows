      "id": "8cf9d419-1764-47eb-83ed-246e40b00bd4",
      "name": "Download Slideshow Photos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1480,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Groups each slideshow's photos into one item so they can be zipped together.\n// Photos are named tiktok_<creator>_<post ID>_01.jpg, _02.jpg, and so on.\nconst posts = new Map();\n\n$input.all().forEach((item, index) => {\n  const { cookies, imageUrls, imageUrl, ...details } = $('Split Slideshow Photos').itemMatching(index).json;\n\n  if (!posts.has(details.videoId)) {\n    posts.set(details.videoId, { json: details, binary: {}, pairedItem: [], count: 0 });\n  }\n  const post = posts.get(details.videoId);\n  post.count += 1;\n  post.pairedItem.push({ item: index });\n\n  const file = item.binary?.data;\n  if (!file) return; // this photo failed to download\n\n  const number = String(post.count).padStart(2, '0');\n  const extension = (file.fileExtension || 'jpg').replace('jpeg', 'jpg');\n  file.fileName = `${details.fileBaseName}_${number}.${extension}`;\n  post.binary[`photo_${number}`] = file;\n});\n\nreturn [...posts.values()].map(({ json, binary, pairedItem }) => {\n  const photoFields = Object.keys(binary);\n  return {\n    json: photoFields.length\n      ? { ...json, photoFields: photoFields.join(',') }\n      : { ...json, mediaType: 'error', error: \"Found the slideshow but couldn't download its photos. Try again in a minute.\" },\n    binary,\n    pairedItem,\n  };\n});\n"
      },
